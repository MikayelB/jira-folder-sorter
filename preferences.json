[
  {
    "property": "extensions.jira-folder-sorter.enabled",
    "label": "Enable Jira Folder Sorter",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "extensions.jira-folder-sorter.jira-base-url",
    "label": "Jira base URL (e.g. https://yourcompany.atlassian.net)",
    "type": "string",
    "placeholder": "https://yourcompany.atlassian.net",
    "defaultValue": ""
  },
  {
    "property": "extensions.jira-folder-sorter.group-by",
    "label": "Group tabs by (epic/story need email+token below)",
    "type": "dropdown",
    "placeholder": "Select a level",
    "defaultValue": "project",
    "options": [
      { "label": "Project (no setup needed)", "value": "project" },
      { "label": "Epic", "value": "epic" },
      { "label": "Story", "value": "story" }
    ]
  },
  {
    "property": "extensions.jira-folder-sorter.group-color",
    "label": "Folder color",
    "type": "dropdown",
    "placeholder": "Select a color",
    "defaultValue": "blue",
    "options": [
      { "label": "Blue", "value": "blue" },
      { "label": "Purple", "value": "purple" },
      { "label": "Cyan", "value": "cyan" },
      { "label": "Orange", "value": "orange" },
      { "label": "Yellow", "value": "yellow" },
      { "label": "Pink", "value": "pink" },
      { "label": "Green", "value": "green" },
      { "label": "Gray", "value": "gray" },
      { "label": "Red", "value": "red" }
    ]
  },
  {
    "property": "extensions.jira-folder-sorter.jira-email",
    "label": "Jira account email (only used for 'epic'/'story' grouping, Jira Cloud)",
    "type": "string",
    "placeholder": "you@company.com",
    "defaultValue": ""
  },
  {
    "property": "extensions.jira-folder-sorter.jira-api-token",
    "label": "Jira API token (only used for 'epic'/'story' grouping - stored in plain text, see README)",
    "type": "string",
    "placeholder": "paste API token here",
    "defaultValue": ""
  }
]
